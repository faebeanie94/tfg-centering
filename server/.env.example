DATABASE_URL=postgresql://user:password@localhost:5432/tfg
GCP_PROJECT_ID=your-project-id
GCP_KEY_FILE=/path/to/service-account-key.json
GCS_BUCKET=your-bucket-name
PORT=5000

# Shared team password for the app's sign-in prompt. Required: without it every
# /api request is rejected. Changing it signs everyone out.
# Generate one with: openssl rand -base64 24
TEAM_PASSWORD=change-me

# Image storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
